# ─────────────────────────────────────────────
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas or local)
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lexi-candles?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/lexi-candles
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lexi-candles?retryWrites=true&w=majority"

# NextAuth
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp number with country code, no + or spaces (e.g. 919876543210 for India)
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
